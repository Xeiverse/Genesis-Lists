# Local development only. Do not use these values behind HTTPS.
PORT=3000
# Placeholder secret — allowed when COOKIE_SECURE=false (logs a warning).
# Production / COOKIE_SECURE=true requires a long random secret.
SESSION_SECRET=dev-insecure-session-secret-change-me
DATABASE_PATH=./data/dev.db
COOKIE_SECURE=false
# Unset = bootstrap (first account, then closed). Docker Compose defaults this to true.
# ALLOW_REGISTRATION=true

# Optional OIDC (see docs/guides/oauth-authentik.md)
# PUBLIC_BASE_URL=http://localhost:3000
# OIDC_ENABLED=false
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_BUTTON_TEXT=Sign in with OIDC
# OIDC_AUTO_REGISTER=true
# OIDC_AUTO_LAUNCH=false
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISABLE_PASSWORD_LOGIN=false
# OIDC_REDIRECT_URI=
