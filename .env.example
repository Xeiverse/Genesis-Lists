# Local development only. Do not use these values behind HTTPS.
PORT=3000
# Placeholder secret — allowed when COOKIE_SECURE=false (logs a warning).
# Production / COOKIE_SECURE=true requires a long random secret.
SESSION_SECRET=dev-insecure-session-secret-change-me
DATABASE_PATH=./data/dev.db
COOKIE_SECURE=false
# Unset = bootstrap (first account, then closed). Docker Compose defaults this to true.
# ALLOW_REGISTRATION=true
# Display names are not unique, so the share picker shows each address by default.
# DIRECTORY_SHOW_EMAILS=true

# Optional OIDC (see docs/guides/oauth-authentik.md)
# Vite dev: SPA is on :5173 and proxies /api — use the Vite origin so the
# final post-login redirect to `/` hits the SPA. Docker/single-port: :3000.
# PUBLIC_BASE_URL=http://localhost:5173
# OIDC_ENABLED=false
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_BUTTON_TEXT=Login with OAuth
# OIDC_AUTO_REGISTER=true
# OIDC_AUTO_LAUNCH=false
# Accounts are matched to the IdP by email address.
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# OIDC_DISABLE_PASSWORD_LOGIN=false
# OIDC_REDIRECT_URI=
