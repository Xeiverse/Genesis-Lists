# Copy to .env next to docker-compose.yml and fill SESSION_SECRET.
# Generate: openssl rand -base64 32
# Do not commit the copied file.

GENESIS_LISTS_VERSION=1.0.0
SESSION_SECRET=

# Required behind HTTPS. The app refuses placeholder secrets in this mode.
COOKIE_SECURE=true

# bootstrap = open only until the first account exists, then closed.
# Set true briefly to add another account, then set this back to bootstrap or false.
ALLOW_REGISTRATION=bootstrap
