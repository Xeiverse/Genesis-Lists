# Copy to .env next to docker-compose.yml and fill SESSION_SECRET.
# Generate: openssl rand -base64 32
# Do not commit the copied file.

GENESIS_LISTS_VERSION=0.2.0
SESSION_SECRET=

# Required behind HTTPS. The app refuses placeholder secrets in this mode.
COOKIE_SECURE=true

# bootstrap = open only until the first account exists, then closed.
# Set true briefly to add another account, then set this back to bootstrap or false.
ALLOW_REGISTRATION=bootstrap

# Optional OIDC — see docs/guides/oauth-authentik.md
# PUBLIC_BASE_URL=https://lists.example.com
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://authentik.example.com/application/o/genesis-lists/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_BUTTON_TEXT=Sign in with Authentik
# OIDC_AUTO_REGISTER=true
# OIDC_AUTO_LAUNCH=false
# Accounts are matched to the IdP by email address.
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# OIDC_DISABLE_PASSWORD_LOGIN=false
# OIDC_REDIRECT_URI=
